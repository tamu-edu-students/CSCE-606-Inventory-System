<% content_for :title, "Bins" %>

<h1>My Bins</h1>
<!-- Create new bin button -->
<div class="d-flex justify-content-start mb-3">
  <%= link_to "➕ Create New Bin", new_bin_path, class: "btn btn-primary" %>
</div>

<!-- Sorting & Filtering -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <!-- Filter by Category -->
  <div class="d-flex align-items-center gap-2">
    <label for="categoryFilter" class="form-label mb-0">Filter by Category:</label>
    <select id="categoryFilter" class="form-select w-auto">
      <option value="">All Categories</option>
      <% categories = Bin.distinct.pluck(:category_name) %>
      <% categories.each do |category| %>
        <%# Debug: Log the category value %>
        <% Rails.logger.debug "Category in dropdown: #{category}" %>
        <option value="<%= category %>"><%= category %></option>
      <% end %>
    </select>
  </div>

  <!-- Sorting Options -->
  <button id="sortByName" class="btn btn-outline-primary">
    Sort by Name ↑
  </button>
</div>

<% if @bins.any? %>
  <div class="bins-container">
    <% @bins.each do |bin| %>
      <%# Debug: Log the bin's category %>
      <% Rails.logger.debug "Bin #{bin.name} category: #{bin.category_name}" %>
      <div class="bin-card" data-category="<%= bin.category_name %>">
        <div class="bin-header">
          <h2 class="bin-title">
            <%= link_to bin.name, bin_path(bin), class: "bin-link" %>
          </h2>
          <%= button_to bin_path(bin),
              method: :delete,
              form: {
                class: "d-inline-block",
                data: { custom_confirm: "Are you sure you want to delete this bin?" }
              },
              class: "border-0 bg-transparent text-danger p-0 m-0" do %>
            <i class="fa-solid fa-trash"></i>
          <% end %>
        </div>
        
        <p class="bin-info">📍 <%= bin.location&.name || 'No location' %></p>
        <p class="bin-info">📦 <%= bin.category_name %></p>

        <!-- Items List -->
        <% if bin.items.any? %>
          <div class="bin-items-list mt-2">
            <p class="fw-bold mb-1">Items in this bin:</p>
            <ul class="list-unstyled mb-0">
              <% bin.items.each do |item| %>
                <li> <%= item.name %></li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <p class="text-muted small">No items in this bin.</p>
        <% end %>

        <div class="bin-image-container">
          <% if bin.bin_picture.attached? %>
            <%= image_tag bin.bin_picture.variant(resize_to_limit: [60, 60]).processed, class: "bin-image", alt: "Bin Picture" %>
          <% else %>
            <%= image_tag "default-bin.jpg", class: "bin-image", alt: "Default Bin Picture" %>
          <% end %>

          <%= link_to edit_bin_path(bin),
            class: "text-primary p-0 m-0 border-0 bg-transparent d-inline-block" do %>
            <i class="fa-solid fa-pen-to-square"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    <i class="fas fa-info-circle me-2"></i>
    You have no bins yet.
  </div>
<% end %>

<div class="actions mt-3">
  <%= link_to "Back to Dashboard", dashboard_path, class: "btn btn-secondary" %>
</div>

<script src="<%= asset_path 'bins.js' %>"></script>
