<p style="color: green"><%= notice %></p>

<% content_for :title, "Bins" %>

<h1>My Bins</h1>

<% if @bins.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Location</th>
        <th>Category</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @bins.each do |bin| %>
        <tr>
          <td><%= link_to bin.name, bin_path(bin) %></td>
          <td><%= bin.location %></td>
          <td><%= bin.category_name %></td>
          <td>
            <%= link_to "Edit", edit_bin_path(bin), class: "btn btn-warning btn-sm" %>
            <%= button_to "Delete", bin, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
          </td>
        </tr>
        <!-- ✅ New Code: Show Items Inside Each Bin -->
        <% if bin.items_in_bin.any? %>
          <tr>
            <td colspan="4">
              <strong>Items in this Bin:</strong>
              <ul>
                <% bin.items_in_bin.each do |item| %>
                  <li>
                    <%= link_to item.name, item_path(item) %> 
                    (<%= item.description %>, <%= number_to_currency(item.value) %>)
                  </li>
                <% end %>
              </ul>
            </td>
          </tr>
        <% else %>
          <tr>
            <td colspan="4"><em>No items in this bin.</em></td>
          </tr>
        <% end %>
        <!-- ✅ End of Item Display -->

      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You have no bins yet.</p>
<% end %>

<%= link_to "Create New Bin", new_bin_path, class: "btn btn-primary" %>
<%= link_to "Back to Dashboard", dashboard_path, class: "btn btn-secondary mt-3" %>
