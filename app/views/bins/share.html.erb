<div class="container mt-4">
  <h2>Share Bin: <%= @bin.name %></h2>
  
  <div class="row">
    <!-- Friends List -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Share with Friends</h5>
          <% if @friends.any? %>
            <div class="list-group">
              <% @friends.each do |friend| %>
                <div class="list-group-item d-flex justify-content-between align-items-center">
                  <span><%= friend.email %></span>
                  <% if @shared_users.include?(friend) %>
                    <%= button_to bin_shared_bin_path(@bin, friend.shared_bins.find_by(bin: @bin)), 
                                method: :delete, 
                                class: "btn btn-danger btn-sm",
                                data: { confirm: "Are you sure you want to remove sharing with this friend?" } do %>
                      <i class="fas fa-user-minus"></i> Remove Access
                    <% end %>
                  <% else %>
                    <%= button_to bin_shared_bins_path(@bin, shared_with_id: friend.id), 
                                method: :post, 
                                class: "btn btn-primary btn-sm" do %>
                      <i class="fas fa-user-plus"></i> Share
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted">You haven't added any friends yet.</p>
            <%= link_to "Add Friends", friendships_path, class: "btn btn-primary" %>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Currently Shared With -->
    <div class="col-md-6">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Currently Shared With</h5>
          <% if @shared_users.any? %>
            <div class="list-group">
              <% @shared_users.each do |user| %>
                <div class="list-group-item">
                  <%= user.email %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted">This bin is not shared with anyone yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
  <div class="mt-4">
    <%= link_to "Back to Bin", @bin, class: "btn btn-secondary" %>
  </div>
</div> 