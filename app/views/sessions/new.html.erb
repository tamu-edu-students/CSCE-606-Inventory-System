<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%= stylesheet_link_tag "sessions", media: "all" %> <!-- 🔥 KEEP -->
  <title>Sign In</title>
</head>
<body>
  <div class="background-image" style="background-image: url('/assets/login-bg.jpg')"></div>

  <div class="container">
    <div class="form-container">
      <div class="brand">
        <i class="fas fa-box-open me-2"></i>Inventory System
      </div>

      <h2>Welcome Back</h2>

      <% if flash[:notice] %>
        <div class="alert alert-success">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="error-message">
          <i class="fas fa-exclamation-circle me-2"></i> <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_with model: resource, url: user_session_path, method: :post, data: { turbo: false }, local: true do |f| %>
        <div class="form-group">
          <label for="email">
            <i class="fas fa-envelope me-2"></i>Email
          </label>
          <%= f.email_field :email, required: true, autofocus: true, placeholder: "Enter your email" %>
        </div>

        <div class="form-group">
          <label for="password">
            <i class="fas fa-lock me-2"></i>Password
          </label>
          <%= f.password_field :password, required: true, placeholder: "Enter your password" %>
        </div>

        <div class="text-end">
          <%= link_to forgot_password_path, class: "forgot-password" do %>
            <i class="fas fa-key me-2"></i>Forgot Password?
          <% end %>
        </div>

        <div class="actions">
          <%= f.submit "Sign In", class: "btn" do %>
            <i class="fas fa-sign-in-alt me-2"></i>Sign In
          <% end %>
        </div>
      <% end %>

      <p class="mt-4">
        Don't have an account? 
        <%= link_to signup_path, class: "ms-1" do %>
          <i class="fas fa-user-plus me-1"></i>Sign Up
        <% end %>
      </p>
    </div> <!-- form-container -->
  </div> <!-- container -->
</body>
</html>
