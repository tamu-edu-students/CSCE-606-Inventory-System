<nav class="navbar">
  <div class="nav-left">
    <span><%= link_to "HOME", dashboard_path, class: "nav-link" %></span>
    <span><%= link_to "BINS", bins_path, class: "nav-link", data: { turbo: false } %></span>
    <span><%= link_to "ITEMS", items_path, class: "nav-link",  data: { turbo: false } %></span>
    <span><%= link_to "FRIENDS", friendships_path, class: "nav-link" %></span>
    <!-- Always show LOG and SALE as text -->
    <div class="log-dropdown">
      <span>
        <%= link_to "LOG", log_history_path, class: "nav-link", id: "log-trigger" %>
      </span>
      <div class="log-dropdown-content" id="log-dropdown-content">
        <%= form_with url: log_history_path, method: :get, local: true do %>
          <div class="date-input-group">
            <label for="from-date">From:</label>
            <input type="date" id="from-date" name="from_date">
          </div>
          <div class="date-input-group">
            <label for="to-date">To:</label>
            <input type="date" id="to-date" name="to_date">
          </div>
          <button type="submit" class="date-search-btn">Search Logs</button>
        <% end %>
      </div>
    </div>
    <div class="sale-dropdown">
      <span><%= link_to "SALE", "", class: "nav-link", id: "sale-trigger" %></span>
      <div class="sale-dropdown-content" id="sale-dropdown-content">
        <div class="sale-input-group">
          <%= form_with url: items_path, method: :get, local: true do %>
            <div class="mb-3">
              <label for="sale-date" class="form-label">Created Before:</label>
              <input type="date" 
                     id="sale-date" 
                     name="sale_date" 
                     value="<%= params[:sale_date] || Date.today.strftime('%Y-%m-%d') %>"
                     class="form-control">
            </div>
            <div class="mb-3">
              <div class="form-check">
                <%= check_box_tag :for_sale, "1", params[:for_sale] == "1", class: "form-check-input", id: "forSaleCheckbox" %>
                <%= label_tag :for_sale, "Only Items For Sale", class: "form-check-label" %>
              </div>
            </div>
            <button type="submit" class="sale-search-btn">Search Items</button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="nav-right">
    <div class="profile-dropdown">
      <%= link_to current_user&.email&.first&.upcase || "A", "", class: "profile-icon", id: "profile-trigger" %>
      <div class="profile-dropdown-content" id="profile-dropdown-content">
        <div class="profile-info">
          <p><strong>Email:</strong> <%= current_user&.email %></p>
          <p><strong>Last login:</strong> 
            <%= Session.where(user: current_user).last&.login_time&.strftime("%Y-%m-%d %H:%M") || "Never" %>
          </p>
        </div>
        <div class="profile-actions">
          <%= button_to "Logout", 
              destroy_user_session_path, 
              method: :delete, 
              class: "logout-button",
              data: { turbo_confirm: "Are you sure you want to log out?" } %>
        </div>
      </div>
    </div>
  </div>
</nav>
