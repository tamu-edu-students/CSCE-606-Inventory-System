<div class="container mt-4">
  <h2>My Friends</h2>
  
  <!-- Add Friend Form -->
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Add Friend</h5>
      <%= form_with url: friendships_path, method: :post, class: "row g-3" do |f| %>
        <div class="col-md-8">
          <%= f.email_field :email, class: "form-control", placeholder: "Enter friend's email" %>
        </div>
        <div class="col-md-4">
          <%= f.submit "Add Friend", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
  
  <!-- Friends List -->
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">Friends List</h5>
      <% if @friends.any? %>
        <div class="list-group">
          <% @friends.each do |friend| %>
            <% friendship = current_user.friendships.find_by(friend: friend) || friend.friendships.find_by(user: friend, friend: current_user) %>
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <span><%= friend.email %></span>
              <%= button_to friendship_path(friendship), 
                          method: :delete, 
                          class: "btn btn-danger btn-sm",
                          data: { confirm: "Are you sure you want to remove this friend?" } do %>
                <i class="fas fa-user-minus"></i> Remove
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted">You haven't added any friends yet.</p>
      <% end %>
    </div>
  </div>
</div> 