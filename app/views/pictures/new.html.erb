<h1>Upload a Picture for <%= @parent.name %></h1>

<%= form_with model: [@parent, @picture], local: true do |form| %>
  <div>
    <%= form.label :image, "Choose a file" %>
    <%= form.file_field :image, direct_upload: true %>
  </div>

  <div>
    <%= form.submit "Upload", class: "btn btn-success" %>
  </div>
<% end %>

<%= link_to "Back", @parent, class: "btn btn-secondary mt-3" %>
