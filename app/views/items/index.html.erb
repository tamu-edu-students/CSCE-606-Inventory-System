<% content_for :title, "Items" %>

<div class="container mt-4">

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
  <div class="flex-grow-1 text-center">
    <h1 class="mb-0" style="margin-left: 90px;">My Items</h1>
  </div>
  <div class="text-end">
    <%= link_to new_item_path, class: "btn btn-primary ms-md-3 mt-3 mt-md-0" do %>
      <i class="fas fa-plus me-1"></i> New Item
    <% end %>
  </div>
</div>

  <!-- 🔍 Filters -->
  <div class="d-flex flex-wrap justify-content-between gap-2 mb-4">
    <input type="text" id="filterInput" class="form-control w-100 w-md-50" placeholder="🔍 Search items by name...">
    <input type="number" id="valueFilter" class="form-control w-100 w-md-25" placeholder="Filter by value...">
    <div class="form-check ms-2">
      <%= check_box_tag :for_sale, "1", params[:for_sale] == "1", class: "form-check-input", id: "forSaleFilter" %>
      <%= label_tag :for_sale, "For Sale Only", class: "form-check-label" %>
    </div>
    <button id="resetFilters" class="btn btn-outline-secondary mt-2 mt-md-1.5">Reset</button>
  </div>

  <% if @items.any? %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
      <% @items.each do |item| %>
        <div class="col item-card"
            data-name="<%= item.name.downcase %>"
            data-value="<%= item.value.to_f %>"
            data-for-sale="<%= item.for_sale %>"
            data-owner="<%= item.bin.user_id == current_user.id %>">

          <div class="card h-100 position-relative shadow-sm p-3">
            <% if item.for_sale %>
              <div class="position-absolute top-0 start-0 mt-2 ms-2">
                <span class="badge bg-success">For Sale</span>
              </div>
            <% end %>

            <!-- Ownership Badge -->
            <div class="position-absolute top-0 end-0 mt-2 me-2">
              <% if item.bin.user_id == current_user.id %>
                <span class="badge bg-primary">Owned</span>
              <% else %>
                <span class="badge bg-info">Shared</span>
              <% end %>
            </div>

            <!-- 🗑 Delete Button -->
            <div class="position-absolute top-0 end-0 mt-2 me-2" style="margin-top: 2.5rem !important;">
              <%= button_to item_path(item), method: :delete,
                  class: "btn btn-sm btn-danger",
                  form: { class: "d-inline", data: { custom_confirm: "Delete this item?" } } do %>
                <i class="fas fa-trash"></i>
              <% end %>
            </div>

            <!-- 🖊 Edit Button -->
            <div class="position-absolute bottom-0 end-0 mb-2 me-2">
              <%= link_to edit_item_path(item), class: "btn btn-sm btn-warning" do %>
                <i class="fas fa-pen"></i>
              <% end %>
            </div>

            <!-- Item Image -->
            <div class="position-absolute bottom-0 start-0 mb-2 ms-2">
              <% if item.item_pictures.attached? %>
                <%= image_tag item.item_pictures.first, width: 50, height: 50, class: "rounded shadow-sm", style: "object-fit: cover;" %>
              <% else %>
                <%= image_tag("default-bin.jpg", width: 50, height: 50, class: "rounded shadow-sm") %>
              <% end %>
            </div>

            <!-- Main Body -->
            <div class="card-body pb-5">
              <h5 class="card-title">
                <%= link_to item.name, item_path(item), class: "text-decoration-none fw-bold" %>
              </h5>
              <p class="mb-1">🗃 <%= item.bin&.name || "Unassigned" %></p>
              <p class="mb-1">📍 <%= item.bin&.location&.name || item.location&.name || "Unassigned" %></p>
              <p class="mb-1">💰 <%= number_to_currency(item.value) %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Add this directly below the cards -->
    <div id="noResultsMessage" class="text-center text-muted mt-4" style="display: none;">
      <i class="fas fa-search fa-3x mb-2"></i>
      <h5>No items to display</h5>
    </div>
  <% else %>
    <div class="text-center py-5">
      <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
      <h3 class="text-muted">No items yet</h3>
      <%= link_to "Add Item", new_item_path, class: "btn btn-primary mt-2" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to dashboard_path, class: "btn btn-outline-secondary" do %>
      <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
    <% end %>
  </div>

</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const filterInput = document.getElementById("filterInput");
    const valueFilter = document.getElementById("valueFilter");
    const forSaleFilter = document.getElementById("forSaleFilter");
    const resetFilters = document.getElementById("resetFilters");
    const itemCards = document.querySelectorAll(".item-card");

    function filterItems() {
      const searchTerm = filterInput.value.toLowerCase();
      const maxValue = valueFilter.value ? parseFloat(valueFilter.value) : Infinity;
      const showForSaleOnly = forSaleFilter.checked;

      itemCards.forEach(card => {
        const name = card.dataset.name;
        const value = parseFloat(card.dataset.value);
        const forSale = card.dataset.forSale === "true";

        const matchesSearch = name.includes(searchTerm);
        const matchesValue = value <= maxValue;
        const matchesForSale = !showForSaleOnly || forSale;

        card.style.display = matchesSearch && matchesValue && matchesForSale ? "" : "none";
      });
    }

    filterInput.addEventListener("input", filterItems);
    valueFilter.addEventListener("input", filterItems);
    forSaleFilter.addEventListener("change", filterItems);

    resetFilters.addEventListener("click", function() {
      filterInput.value = "";
      valueFilter.value = "";
      forSaleFilter.checked = false;
      filterItems();
    });
  });
</script>