<% content_for :title, "Editing item" %>

<h1>Editing item</h1>

<%= render "form", item: @item %>

<br>

<div class="mt-3">
  <%= link_to "Show this item", @item, class: "btn btn-info" %> |
  <%= link_to "Back to items", items_path, class: "btn btn-secondary" %>
</div>

<div class="mt-4">
  <p class="text-muted">
    <i class="fas fa-info-circle"></i>
    You can leave the bin unselected to mark this item as unassigned.
  </p>
</div>

<% content_for :styles do %>
  <style>
    .field {
      margin-bottom: 1rem;
    }
    
    .field label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: bold;
    }
    
    .field input[type="text"],
    .field input[type="number"],
    .field select {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    
    #error_explanation {
      color: #dc3545;
      padding: 1rem;
      margin-bottom: 1rem;
      border: 1px solid #dc3545;
      border-radius: 4px;
      background-color: #f8d7da;
    }
    
    #error_explanation h2 {
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
    }
    
    .image-preview {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    
    .preview-container {
      text-align: center;
    }
  </style>
<% end %>

<script>
  const binLocationMap = <%= raw @bin_location_map.to_json %>;
</script>

<script>
  document.addEventListener("turbo:load", function () {
    const binSelect = document.getElementById("binSelect");
    const locationSelect = document.getElementById("locationSelect");

    function toggleLocation() {
      const selectedBinId = binSelect.value;

      if (!selectedBinId) {
        locationSelect.disabled = false;
      } else {
        const locationId = binLocationMap[selectedBinId];
        locationSelect.value = locationId || "";
        locationSelect.disabled = true;
      }
    }

    binSelect.addEventListener("change", toggleLocation);
    toggleLocation();
  });
</script>
