<% content_for :title, "Editing item" %>

<h1>Editing item</h1>

<%= form_with(model: @item, local: true) do |form| %>
  <%= hidden_field_tag :bin_id, params[:bin_id] if params[:bin_id].present? %>
  <% if @item.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
        <% @item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 3 %>
  </div>

  <div class="field">
    <%= form.label :value %>
    <%= form.number_field :value %>
  </div>

    <div class="field">
    <%= form.label :bin_id, "Select Bin" %>
    <%= form.collection_select :bin_id, @bins, :id, :name, { prompt: "Choose a bin" }, { id: "binSelect", class: "form-select" } %>
  </div>

  <div class="field" id="locationField">
    <%= form.label :location_id, "Location" %>
    <%= form.collection_select :location_id, @locations, :id, :name,
        { include_blank: true },
        { class: "form-select", id: "locationSelect", disabled: @item.bin_id.present? } %>
  </div>


  <div class="field">
    <%= form.label :item_pictures %>
    <%= form.file_field :item_pictures, multiple: true %>
  </div>

  <% if @item.item_pictures.attached? %>
    <div class="field">
      <p><strong>Current Pictures:</strong></p>
      <div class="image-preview">
        <% @item.item_pictures.each do |picture| %>
          <div class="preview-container">
            <%= image_tag picture, class: "img-thumbnail", style: "width: 100px; height: 100px; object-fit: cover;" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="actions mt-3">
    <%= form.submit "Update Item", class: "btn btn-primary" %>
  </div>
<% end %>

<br>

<div class="mt-3">
  <%= link_to "Show this item", @item, class: "btn btn-info" %> |
  <%= link_to "Back to items", items_path, class: "btn btn-secondary" %>
</div>

<div class="mt-4">
  <p class="text-muted">
    <i class="fas fa-info-circle"></i>
    You can leave the bin unselected to mark this item as unassigned.
  </p>
</div>

<% content_for :styles do %>
  <style>
    .field {
      margin-bottom: 1rem;
    }
    
    .field label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: bold;
    }
    
    .field input[type="text"],
    .field input[type="number"],
    .field select {
      width: 100%;
      padding: 0.5rem;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
    
    #error_explanation {
      color: #dc3545;
      padding: 1rem;
      margin-bottom: 1rem;
      border: 1px solid #dc3545;
      border-radius: 4px;
      background-color: #f8d7da;
    }
    
    #error_explanation h2 {
      font-size: 1.2rem;
      margin-bottom: 0.5rem;
    }
    
    .image-preview {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 0.5rem;
    }
    
    .preview-container {
      text-align: center;
    }
  </style>
<% end %>

<script>
  const binLocationMap = <%= raw @bin_location_map.to_json %>;
</script>


<script>
  document.addEventListener("turbo:load", function () {
    const binSelect = document.getElementById("binSelect");
    const locationSelect = document.getElementById("locationSelect");

    function toggleLocation() {
      const selectedBinId = binSelect.value;

      if (!selectedBinId) {
        locationSelect.disabled = false;
      } else {
        const locationId = binLocationMap[selectedBinId];
        locationSelect.value = locationId || "";
        locationSelect.disabled = true;
      }
    }

    binSelect.addEventListener("change", toggleLocation);
    toggleLocation();
  });
</script>
